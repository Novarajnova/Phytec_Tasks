/*
 * STM32F446RE UART Client Code to Send File in Packets
 * Sends packet with sequence number, waits for ACK, and retransmits if necessary.
 * Uses UART2 for communication
 */

#include "main.h"
#include <string.h>
#include <stdio.h>

UART_HandleTypeDef huart2;

#define PACKET_SIZE 128
#define UART_TIMEOUT 100

/* Packet structure */
typedef struct {
    uint16_t seq_no;
    uint16_t data_len;
    uint8_t data[PACKET_SIZE];
} Packet;

const uint8_t file_data[] = "Hello from STM32 Board!\nThis simulates a file transfer over UART.\nBye!\n";
const uint32_t file_size = sizeof(file_data) - 1;

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);

/* Send a packet with sequence number and wait for ACK */
void send_packet(uint16_t seq_no, const uint8_t *data, uint16_t len) {
    Packet pkt;
    pkt.seq_no = seq_no;
    pkt.data_len = len;
    memcpy(pkt.data, data, len);

    HAL_UART_Transmit(&huart2, (uint8_t *)&pkt, sizeof(pkt.seq_no) + sizeof(pkt.data_len) + len, HAL_MAX_DELAY);
}

int main(void) {
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART2_UART_Init();

    uint32_t bytes_sent = 0;
    uint16_t seq = 0;
    uint8_t ack_buf[2];

    while (bytes_sent < file_size) {
        uint16_t chunk = (file_size - bytes_sent > PACKET_SIZE) ? PACKET_SIZE : (file_size - bytes_sent);
        send_packet(seq, &file_data[bytes_sent], chunk);

        // Wait for ACK
        if (HAL_UART_Receive(&huart2, ack_buf, 2, UART_TIMEOUT) == HAL_OK) {
            uint16_t ack_seq = ack_buf[0] | (ack_buf[1] << 8);
            if (ack_seq == seq) {
                bytes_sent += chunk;
                seq++;
            }
        }
    }

    // Send EOF packet
    Packet eof_pkt = { .seq_no = seq, .data_len = 0 };
    HAL_UART_Transmit(&huart2, (uint8_t *)&eof_pkt, sizeof(eof_pkt.seq_no) + sizeof(eof_pkt.data_len), HAL_MAX_DELAY);

    while (1);
}

